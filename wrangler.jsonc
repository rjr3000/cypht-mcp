{
  "name": "cypht-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CYPHT_STATE",
        "class_name": "CyphtState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-setup-catalog",
      "new_sqlite_classes": [
        "CyphtState"
      ]
    }
  ],
  "workers_dev": true
}
